# Zerodha Kite Connect Credentials
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# OpenAI (for LLM features - if using OpenAI provider)
OPENAI_API_KEY=your_openai_key_here

# Local Llama Configuration (if using ollama/llamacpp/lmstudio provider)
# Uncomment and configure based on your setup:
LLAMA_BASE_URL=http://localhost:11434  # Ollama default
# LLAMA_BASE_URL=http://localhost:8080  # llama.cpp default
# LLAMA_BASE_URL=http://localhost:1234  # LM Studio default
LLAMA_MODEL=llama3.2  # Model name

# Trading Mode: PAPER or LIVE
TRADING_MODE=PAPER

# Telegram Alerts (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
